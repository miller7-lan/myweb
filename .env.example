SMTP_USER=your_email@example.com
SMTP_PASS=your_qq_mail_smtp_authorization_code
CONTACT_TO=contact@example.com
HOST=127.0.0.1
PORT=3001
PUBLIC_ORIGIN=http://127.0.0.1:3001
TRUST_PROXY=0
CONTACT_DAILY_LIMIT=3
CONTACT_PER_SECOND_LIMIT=1
CONTACT_RATE_WINDOW_MS=5000
DOWNLOAD_PER_SECOND_LIMIT=2
DOWNLOAD_RATE_WINDOW_MS=5000
CONTACT_COOKIE_SECRET=change_this_to_a_long_random_secret
CONTACT_COOKIE_SECURE=0
CONTACT_RATE_STORE_PATH=.contact-rate-limits.json
ALLOW_LOCAL_ORIGINS=1
VITE_CONTACT_API_URL=
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cloudflare Pages announcement admin.
# Generate ADMIN_PASSWORD_HASH with:
# node scripts/hash-admin-password.mjs "your-long-admin-password"
ADMIN_USERNAME=dazzle
ADMIN_PASSWORD_HASH=pbkdf2-sha256$100000$replace_with_salt$replace_with_hash
ADMIN_SESSION_SECRET=replace_with_at_least_32_random_characters
ADMIN_LOGIN_BURST_LIMIT=6
ADMIN_LOGIN_DAILY_LIMIT=12
